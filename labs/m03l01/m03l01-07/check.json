{
  "lab": "m03l01-07",
  "lesson": "m03l01",
  "title": "The environment beats the file, the flag beats both",
  "mode": "run",
  "runner": "terraform",
  "command": "terraform init; sh session.sh",
  "main": "session.sh",
  "files": [
    "main.tf",
    "session.sh",
    "terraform.tfvars",
    "variables.tf"
  ],
  "stdin": null,
  "expected": null,
  "grading": null,
  "requires": [
    "sh",
    "terraform"
  ],
  "tool": "terraform",
  "commands": [
    {
      "id": "recorded",
      "label": "Recorded session",
      "line": "terraform init; sh session.sh"
    },
    {
      "id": "init",
      "label": "Init",
      "line": "terraform init"
    },
    {
      "id": "validate",
      "label": "Validate",
      "line": "terraform validate"
    },
    {
      "id": "plan",
      "label": "Plan",
      "line": "terraform plan"
    },
    {
      "id": "apply",
      "label": "Apply",
      "line": "terraform apply -auto-approve"
    },
    {
      "id": "fmt",
      "label": "Format check",
      "line": "terraform fmt -check -diff"
    },
    {
      "id": "output",
      "label": "Output",
      "line": "terraform apply -auto-approve && terraform output"
    }
  ],
  "note": "the recorded output depends on the machine it ran on, so the site runs it without a pass or fail."
}
